{
  "$schema": "alpbahOS/desktop-tokens/v0",
  "durum": "taslak — gerçek Plasma oturumunda doğrulanmadı",
  "kaynak": "docs/alpbahOS-design-mockups.md §3.1-3.3, §7",
  "color": {
    "bg-950": "#0b1014",
    "bg-900": "#11171c",
    "surface-800": "#16232d",
    "surface-700": "#1d2c38",
    "border": "#29404f",

    "navy": "#062746",
    "navy-strong": "#031a31",
    "cyan": "#00aeef",
    "cyan-soft": "#54d6ff",
    "orange": "#f5a623",
    "orange-soft": "#ffc45d",

    "text-strong": "#f4f8fb",
    "text": "#d4e0e8",
    "text-muted": "#8ea2af",
    "text-disabled": "#53636d",

    "success": "#35d07f",
    "warning": "#f5a623",
    "danger": "#ff6575",
    "info": "#4fc9ff"
