    "grafit_koyu_zemin": 0.60,
    "lacivert_yuzey": 0.25,
    "elektrik_mavisi": 0.10,
    "turuncu_vurgu": 0.05
  },
  "typography": {
    "font_primary": "Inter",
    "font_terminal": "JetBrains Mono",
    "font_terminal_alt": "Cascadia Code",
    "weight_heading": [600, 700],
    "weight_body": [400, 500],
    "size": {
      "display": 32,
