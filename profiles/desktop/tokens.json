      "hedef_donanim": "2-4 CPU, 4-8 GiB RAM, eski/iGPU"
    },
    "glass": {
      "durum": "secenek",
      "uygulandi": false,
      "aciklama": "Kontrollü saydamlık, arka plan bulanıklığı, okunaklı yüzeyler.",
      "hedef_donanim": "Donanım hızlandırmalı standart masaüstü"
    },
    "liquid": {
      "durum": "deneysel",
      "uygulandi": false,
      "aciklama": "Cam kenarı, ışık ve mümkünse kırılma davranışı. Prototip ve ölçüm gerektirir; hazır/sorunsuz çözüm varsayılmaz.",
      "hedef_donanim": "Güçlü cihaz (ör. RTX)",
      "uyari": "MASTER_PLAN §7.2: yalnız blur uygulanmışsa bu 'Glass' sayılır, 'Liquid' değil."
    }
  },
  "accessibility": {
    "reduced_motion_supported": "planlanan, test edilmedi",
    "min_contrast": "WCAG AA (planlanan, ölçülmedi)",
    "state_by_color_alone": false
