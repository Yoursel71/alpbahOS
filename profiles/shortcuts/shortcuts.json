      "bindings": [
        {
          "kind": "component",
          "component": "kwin",
          "action": "Show Desktop",
          "friendly": "Peek at Desktop",
          "set": ["Meta+D"],
          "upstream_default": ["Meta+D"],
          "upstream_kaynak": "kwin v6.4.4 src/useractions.cpp Workspace::initShortcuts"
        }
