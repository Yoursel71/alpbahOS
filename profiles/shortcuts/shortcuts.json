    "engelli": "Eylemi kaydeden bileşen mevcut imajda derlenmemiş/devre dışı; bağlama yazılır ama çalışmaz.",
    "uygulama_varsayilani": "Sistem kısayolu değil; uygulama katmanının standardı, alpbahOS yeniden tanımlamaz."
  },
  "anahtar_notu": "keys: satırın Windows kullanıcısına vaat ettiği tuşlar (canlı doğrulayıcı bunları zorunlu tutar). bindings[].set: kglobalshortcutsrc içine yazılacak TAM tuş listesi (upstream ek tuşları korunur). bindings[].upstream_default: kaynak koddaki varsayılan. 'Meta' Windows tuşudur.",
  "shortcuts": [
    {
      "id": "walk-windows",
      "keys": ["Alt+Tab", "Alt+Shift+Tab"],
      "eylem_tr": "Pencereler arasında ileri/geri geçiş",
      "durum": "yeniden_esleme",
      "bindings": [
        {
          "kind": "component",
          "component": "kwin",
          "action": "Walk Through Windows",
          "friendly": "Walk Through Windows",
          "set": ["Alt+Tab"],
          "upstream_default": ["Meta+Tab", "Alt+Tab"],
          "upstream_kaynak": "kwin v6.4.4 src/tabbox/tabbox.cpp TabBox::initShortcuts"
        },
        {
          "kind": "component",
          "component": "kwin",
          "action": "Walk Through Windows (Reverse)",
          "friendly": "Walk Through Windows (Reverse)",
          "set": ["Alt+Shift+Tab"],
          "upstream_default": ["Meta+Shift+Tab", "Alt+Shift+Tab"],
          "upstream_kaynak": "kwin v6.4.4 src/tabbox/tabbox.cpp TabBox::initShortcuts",
          "birakilan": {
            "Meta+Shift+Tab": "Win+Tab genel görünüme verildiği için ters yönlü Win+Shift+Tab pencere geçişinde tutulmadı; Windows'ta da karşılığı yok."
          }
        }
      ],
      "not": "Upstream Meta+Tab'ı da pencere geçişine bağlıyor; Win+Tab genel görünüme verildiği için Meta+Tab ve Meta+Shift+Tab buradan çıkarıldı.",
      "test_kapsami": "Çoklu pencere ve çoklu ekran"
    },
    {
