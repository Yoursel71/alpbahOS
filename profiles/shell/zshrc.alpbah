# alpbahOS interaktif Zsh profili (D119, SHELL-R4-01)
#
# /etc/alpbahos/zshrc.alpbah olarak kurulur; /etc/zsh/zshrc her etkileşimli Zsh'de yükler (kullanıcının ~/.zshrc
# dosyası kendi ayarları içindir). Sistem shell'i (/bin/sh) ve build scriptlerinin yorumlayıcısı bundan ETKİLENMEZ.
#
# Kaynak: docs/MASTER_PLAN.md §4

# --- Tamamlama sistemi (Zsh yerleşik) ---
autoload -Uz compinit
compinit

# --- Geçmiş ---
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=20000
SAVEHIST=20000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# Ctrl+R: geçmiş arama (yerleşik, fuzzy değil — açık karar)
bindkey '^R' history-incremental-search-backward

# --- Yazım düzeltme: yalnızca komut adı, tüm argümanlar DEĞİL ---
# CLAUDE.md: "Yazım yardımı argümanları/dosya adlarını sessizce yeniden yazmaz."
setopt CORRECT
unsetopt CORRECT_ALL

# --- zsh-autosuggestions (soluk öneri) ---
# Kaynak: https://github.com/zsh-users/zsh-autosuggestions
# Paket/kurulum yolu BUILD/BLFS entegrasyonunda sabitlenir.
#
# NOT: Eklentinin VARSAYILAN davranışı zaten "kabul != çalıştır" ayrımını
# sağlar (sağ ok / End önericiyi satıra alır, Enter ayrı adımdır). Bu profil
# o davranışı override ETMEZ; yalnızca renk ve kaynağı özelleştirir.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#8ea2af'   # --ab-text-muted (soluk gri-mavi)

if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# --- zsh-syntax-highlighting ---
# Kaynak: https://github.com/zsh-users/zsh-syntax-highlighting
# NOT: Bu eklenti diğer keybinding'lerden SONRA source edilmelidir (upstream uyarısı).
if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# --- Tab tamamlama görünümü ---
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- alp paket adı tamamlama (MASTER_PLAN §4.3 madde 4) ---
# Kaynak: yerel katalog index.json (ALP_INDEX ortam değişkeni, yoksa
# /usr/share/alp/index.json). Yalnız okur; root ya da ağ gerekmez.
# alp CLI sözleşmesi: alp.py (docs/handoffs/claude/alp-prototype/).
_alp_index_names() {
  local idx=${ALP_INDEX:-/usr/share/alp/index.json}
  [[ -r $idx ]] || return 1
  python3 -I -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1],encoding="utf-8")).get("entries",{}).keys()))' "$idx" 2>/dev/null
}

_alp() {
  local -a subcmds pkgs
  subcmds=(search info list install remove upgrade autoremove update check recover protect unprotect help)
  if (( CURRENT == 2 )); then
    _describe 'alp komutu' subcmds
    return
  fi
  case $words[2] in
    install|info|remove|upgrade|protect|unprotect)
      pkgs=(${(f)"$(_alp_index_names)"})
      (( ${#pkgs} )) && _describe 'paket' pkgs
      ;;
  esac
}
compdef _alp alp

# --- Başka dağıtımların paket yöneticisi komutları (D123) ---
# apt/dnf/pacman/... yazılırsa komut ÇALIŞTIRILMAZ; yalnızca alp karşılığı
# ipucu yazılır. İpucu hiçbir şeyi kendi başına çalıştırmaz.
# Diğer bilinmeyen komutlar zsh'nin normal davranışıyla aynı kalır (127).
command_not_found_handler() {
  local cmd=$1 sub
  shift
  case $cmd in
    apt|apt-get|dnf|yum|zypper|pacman|snap)
      sub=$1
      [[ $# -gt 0 ]] && shift
      local -a suggest
      case $sub in
        install)                suggest=(alp install "$@") ;;
        remove|purge|uninstall) suggest=(alp remove "$@") ;;
        update|upgrade|refresh) suggest=(alp update) ;;
        search)                 suggest=(alp search "$@") ;;
        show|info)              suggest=(alp info "$@") ;;
        *)                      suggest=(alp help) ;;
      esac
      print -r -u2 -- "alpbahOS'ta '$cmd' yok. Bunun yerine: ${(j: :)suggest}"
      ;;
    *)
      print -r -u2 -- "zsh: komut bulunamadı: $cmd"
      ;;
  esac
  return 127
}

# --- Ctrl+C ---
# Zsh'nin varsayılan SIGINT/iş kesme davranışı KORUNUR; bu profil tarafından
# yeniden bağlanmaz veya "kopyala" gibi başka bir anlama getirilmez.

# --- alpbahOS neofetch ASCII karşılaması (isteğe bağlı, varsayılan KAPALI) ---
# if [ -f /etc/alpbahos/branding/alpbahOS-neofetch-ansi.txt ]; then
#   cat /etc/alpbahos/branding/alpbahOS-neofetch-ansi.txt
# fi

# --- Prompt (taslak) ---
# 256-color kod numaraları --ab-cyan / --ab-cyan-soft için YAKLAŞIK eşleşmedir;
# gerçek terminalde truecolor doğrulaması yapılmadı.
autoload -Uz colors && colors
PROMPT='%F{39}%n@%m%f:%F{75}%~%f%# '
