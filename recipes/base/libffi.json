{
  "abi": "multilib-m32",
  "allowed_jobs": [
    1,
    2,
    4,
    8
  ],
  "basis": {
    "architecture": "ml_32",
    "book": "MLFS ml-12.4 m32-systemd",
    "commit": "d7bc803361f445a649d0ca0832219f75b6e68683",
    "file": "chapter08/libffi.xml",
    "repository": "https://git.linuxfromscratch.org/lfs.git",
    "sha256": "78028564e6ea66f37394b43d9d9d3a86616c92999ad9194e2f2637b533b85def",
    "tag": "ml-12.4"
  },
  "compile": [
    [
      "./configure",
      "--prefix=/usr",
      "--disable-static",
      "--without-gcc-arch"
    ],
    [
      "make",
      "-j{jobs}"
    ]
  ],
  "environment": {},
  "jobs": 8,
  "name": "libffi",
  "phase": "base",
  "post_stage": [
    [
      "make",
      "distclean"
    ],
    [
      "env",
      "CC=gcc -m32",
      "CXX=g++ -m32",
      "./configure",
      "--host=i686-pc-linux-gnu",
      "--prefix=/usr",
      "--libdir=/usr/lib32",
      "--disable-static",
      "--with-gcc-arch=i686"
    ],
    [
      "make",
      "-j{jobs}"
    ],
    [
      "make",
      "-j{jobs}",
      "check"
    ],
    [
      "make",
      "-j1",
      "DESTDIR={stage}/.m32",
      "install"
    ],
    [
      "mkdir",
      "-p",
      "{stage}/usr/lib32"
    ],
    [
      "cp",
      "-a",
      "{stage}/.m32/usr/lib32/.",
      "{stage}/usr/lib32/"
    ],
    [
      "rm",
      "-rf",
      "{stage}/.m32"
    ]
  ],
  "pre": [],
  "requires": [
    "glibc"
  ],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
  "source": "libffi-3.5.2.tar.gz",
  "stage": [
    [
      "make",
      "-j1",
      "DESTDIR={stage}",
      "install"
    ]
  ],
  "strip_stage_prefix": "",
  "test": [
    [
      "make",
      "-j{jobs}",
      "check"
    ]
  ],
  "validation": "Pinned MLFS m64 generic build plus test and m32 i686 build/test staged only under /usr/lib32. Native CPU tuning is disabled; x32 is excluded. No guest build or Alp ownership acceptance yet.",
  "version": "3.5.2"
}
