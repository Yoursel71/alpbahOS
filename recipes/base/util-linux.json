  "name": "util-linux",
  "phase": "base",
  "post_stage": [
    [
      "make",
      "distclean"
    ],
    [
      "env",
      "PKG_CONFIG_PATH=/usr/lib32/pkgconfig",
      "NCURSESW6_CONFIG=/bin/false",
