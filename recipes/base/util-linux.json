      "ADJTIME_PATH=/var/lib/hwclock/adjtime",
      "--host=i686-pc-linux-gnu",
      "--bindir=/usr/bin",
      "--libdir=/usr/lib32",
      "--runstatedir=/run",
      "--sbindir=/usr/sbin",
      "--disable-chfn-chsh",
      "--disable-login",
      "--disable-nologin",
      "--disable-su",
      "--disable-setpriv",
      "--disable-runuser",
      "--disable-pylibmount",
      "--disable-liblastlog2",
      "--disable-static",
      "--without-python",
      "--docdir=/usr/share/doc/util-linux-2.41.1"
    ],
    [
      "make",
      "-j{jobs}"
    ],
    [
      "make",
      "-j1",
      "DESTDIR={stage}/.m32",
