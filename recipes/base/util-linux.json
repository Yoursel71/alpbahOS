  "strip_stage_prefix": "",
  "test": [
    [
      "bash",
      "-euc",
      "backup=\"$(mktemp -d /tmp/alp-util-linux-fstab.XXXXXX)\"\nhad=0\nchanged=0\nrestore() {{\n  status=$?\n  trap - EXIT\n  if (( changed )); then\n    if (( had )); then\n      rm -f -- /etc/fstab\n      cp -a -- \"$backup/original\" /etc/fstab || status=1\n    else\n      rm -f -- /etc/fstab || status=1\n    fi\n  fi\n  rm -rf -- \"$backup\" || status=1\n  exit \"$status\"\n}}\ntrap restore EXIT\nif [[ -e /etc/fstab || -L /etc/fstab ]]; then\n  [[ ! -d /etc/fstab || -L /etc/fstab ]] || exit 1\n  cp -a -- /etc/fstab \"$backup/original\"\n  had=1\nfi\nchanged=1\n: > /etc/fstab\nchown -hR tester:tester .\nrunuser -u tester -- env LC_ALL=C LANG=C TZ=UTC make -k check </dev/null"
    ]
  ],
  "test_locale": "C",
  "test_user": "root",
  "validation": "Pinned MLFS ml-12.4 Util-linux 2.41.1 m64 build/test/stage plus documented i686 m32 build staged only under /usr/lib32. The m32 configure pins NCURSESW6_CONFIG=/bin/false to avoid the host-width helper without moving host files. The book test executes as tester inside the Builder VM with a temporary /etc/fstab fixture restored on all exits. No guest build or Alp ownership acceptance yet.",
  "version": "2.41.1"
}
