{
  "abi": "multilib-m32",
  "allowed_jobs": [
    1,
    2,
    4,
    8
  ],
  "basis": {
    "architecture": "ml_32",
    "book": "MLFS ml-12.4 m32-systemd",
    "commit": "d7bc803361f445a649d0ca0832219f75b6e68683",
    "file": "chapter08/zstd.xml",
    "repository": "https://git.linuxfromscratch.org/lfs.git",
    "sha256": "d74d1341d8531397f54368630e97c6c0c3423eb65eef5e67c44aabd17bcc9500",
    "tag": "ml-12.4"
  },
  "compile": [
    [
      "make",
      "prefix=/usr",
      "-j{jobs}"
    ]
  ],
  "environment": {},
  "jobs": 8,
  "name": "zstd",
  "phase": "base",
  "post_stage": [
    [
      "make",
      "clean"
    ],
    [
      "env",
      "CC=gcc -m32",
      "make",
      "prefix=/usr",
      "-j{jobs}"
    ],
    [
      "make",
      "prefix=/usr",
      "DESTDIR={stage}/.m32",
      "install"
    ],
    [
      "mkdir",
      "-p",
      "{stage}/usr/lib32"
    ],
    [
      "cp",
      "-a",
      "{stage}/.m32/usr/lib/.",
      "{stage}/usr/lib32/"
    ],
    [
      "sed",
      "-e",
      "/^libdir/s|/lib$|/lib32|",
      "-i",
      "{stage}/usr/lib32/pkgconfig/libzstd.pc"
    ],
    [
      "rm",
      "-rf",
      "{stage}/.m32"
    ]
  ],
  "requires": [
    "zlib",
    "glibc"
  ],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
  "source": "zstd-1.5.7.tar.gz",
  "stage": [
    [
      "make",
      "-j1",
      "prefix=/usr",
      "DESTDIR={stage}",
      "install"
    ],
    [
      "rm",
      "-f",
      "{stage}/usr/lib/libzstd.a"
    ]
  ],
  "strip_stage_prefix": "",
  "test": [
    [
      "make",
      "-j{jobs}",
      "check"
    ]
  ],
  "validation": "Recipe only; m64/m32 build, tests and Alp ownership remain unverified",
  "version": "1.5.7"
}
