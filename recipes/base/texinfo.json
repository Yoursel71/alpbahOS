  "stage": [
    [
      "make",
      "-j1",
      "DESTDIR={stage}",
      "install"
    ],
    [
      "make",
      "-j1",
      "DESTDIR={stage}",
      "TEXMF=/usr/share/texmf",
      "install-tex"
    ]
  ],
  "test": [
    [
      "make",
      "check"
    ]
  ],
