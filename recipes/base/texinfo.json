  "environment": {},
  "jobs": 4,
  "name": "texinfo",
  "phase": "base",
  "pre": [
    [
      "find",
      "tp/Texinfo/Convert",
      "-type",
      "f",
      "-name",
      "*.pm",
      "-exec",
      "sed",
      "s/! $output_file eq/$output_file ne/",
      "-i",
      "{{}}",
      "+"
