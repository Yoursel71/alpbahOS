{
  "abi": "multilib-m32",
  "allowed_jobs": [1, 2, 4, 8],
  "basis": {
    "architecture": "ml_32",
    "book": "MLFS ml-12.4 m32-systemd",
    "commit": "d7bc803361f445a649d0ca0832219f75b6e68683",
    "file": "chapter08/pkgconf.xml",
    "repository": "https://git.linuxfromscratch.org/lfs.git",
    "sha256": "4eeb2adce2209539f4d11a81ab28a836b309c00c2cc62ccfa2196fead2f1822d",
    "tag": "ml-12.4"
  },
  "build_files": {
    "infra-alp-personalities/i686-pc-linux-gnu.personality": "Triplet: i686-pc-linux-gnu\nSysrootDir: /\nDefaultSearchPaths: /usr/lib32/pkgconfig:/usr/share/pkgconfig\nSystemIncludePaths: /usr/include\nSystemLibraryPaths: /usr/lib32\n",
    "infra-alp-personalities/x86_64-pc-linux-gnu.personality": "Triplet: x86_64-pc-linux-gnu\nSysrootDir: /\nDefaultSearchPaths: /usr/lib/pkgconfig:/usr/share/pkgconfig\nSystemIncludePaths: /usr/include\nSystemLibraryPaths: /usr/lib\n"
  },
  "compile": [
    ["./configure", "--prefix=/usr", "--disable-static", "--docdir=/usr/share/doc/pkgconf-2.5.1"],
    ["make", "-j{jobs}"]
  ],
  "environment": {},
  "jobs": 8,
  "name": "pkgconf",
  "phase": "base",
  "post_stage": [
    ["ln", "-s", "pkgconf", "{stage}/usr/bin/pkg-config"],
    ["ln", "-s", "pkgconf.1", "{stage}/usr/share/man/man1/pkg-config.1"],
    ["ln", "-s", "pkgconf", "{stage}/usr/bin/i686-pc-linux-gnu-pkg-config"],
    ["ln", "-s", "pkgconf", "{stage}/usr/bin/x86_64-pc-linux-gnu-pkg-config"],
    ["install", "-Dm644", "{source}/infra-alp-personalities/i686-pc-linux-gnu.personality", "{stage}/usr/share/pkgconfig/personality.d/i686-pc-linux-gnu.personality"],
    ["install", "-Dm644", "{source}/infra-alp-personalities/x86_64-pc-linux-gnu.personality", "{stage}/usr/share/pkgconfig/personality.d/x86_64-pc-linux-gnu.personality"]
  ],
  "requires": ["glibc"],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
  "source": "pkgconf-2.5.1.tar.xz",
  "stage": [["make", "-j1", "DESTDIR={stage}", "install"]],
  "strip_stage_prefix": "",
  "test": [],
  "validation": "64-bit utility plus m32/m64 pkg-config personalities; builds and Alp ownership remain unverified",
  "version": "2.5.1"
}
