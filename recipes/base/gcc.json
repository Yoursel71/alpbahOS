{
  "abi": "multilib-m32",
  "allowed_jobs": [
    1,
    2,
    4,
    8
  ],
  "basis": {
    "architecture": "ml_32",
    "book": "MLFS ml-12.4 m32-systemd",
    "commit": "d7bc803361f445a649d0ca0832219f75b6e68683",
    "file": "chapter08/gcc.xml",
    "repository": "https://git.linuxfromscratch.org/lfs.git",
    "sha256": "473f1b6097fe51655d02ac9660d0e9b67d620e35d628e50f3c0925df8becfeff",
    "tag": "ml-12.4"
  },
  "compile": [
    [
      "../configure",
      "--prefix=/usr",
      "LD=ld",
      "--enable-languages=c,c++",
      "--enable-default-pie",
      "--enable-default-ssp",
      "--enable-host-pie",
      "--enable-multilib",
      "--with-multilib-list=m64,m32",
      "--disable-bootstrap",
      "--disable-fixincludes",
      "--with-system-zlib"
    ],
    [
      "make",
      "-j{jobs}"
    ]
  ],
  "configure_build_guess": "config.guess",
  "environment": {},
  "jobs": 4,
  "name": "gcc",
  "phase": "base",
  "post_stage": [
    [
      "ln",
      "-s",
      "../bin/cpp",
      "{stage}/usr/lib/cpp"
    ],
    [
      "ln",
      "-s",
      "gcc.1",
      "{stage}/usr/share/man/man1/cc.1"
    ],
    [
      "ln",
      "-s",
      "../../libexec/gcc/{build_triplet}/15.2.0/liblto_plugin.so",
      "{stage}/usr/lib/bfd-plugins/liblto_plugin.so"
    ],
    [
      "bash",
      "-euc",
      "shopt -s nullglob; files=(\"$1\"/*gdb.py); if ((${{#files[@]}})); then mv -- \"${{files[@]}}\" \"$2\"; fi",
      "_",
      "{stage}/usr/lib",
      "{stage}/usr/share/gdb/auto-load/usr/lib"
    ]
  ],
  "pre": [
    [
      "sed",
      "-e",
      "/m64=/s/lib64/lib/",
      "-e",
      "/m32=/s/m32=.*/m32=..\\/lib32$(call if_multiarch,:i386-linux-gnu)/",
      "-i.orig",
      "gcc/config/i386/t-linux64"
    ],
    [
      "sed",
      "/STACK_REALIGN_DEFAULT/s/0/(!TARGET_64BIT \\&\\& TARGET_SSE)/",
      "-i",
      "gcc/config/i386/i386.h"
    ]
  ],
  "requires": [
    "glibc",
    "zlib",
    "binutils",
    "gmp",
    "mpfr",
    "mpc"
  ],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
  "separate_build": true,
  "source": "gcc-15.2.0.tar.xz",
  "stage": [
    [
      "make",
      "-j1",
      "DESTDIR={stage}",
      "install"
    ],
    [
      "install",
      "-d",
      "{stage}/usr/lib/bfd-plugins",
      "{stage}/usr/share/man/man1",
      "{stage}/usr/share/gdb/auto-load/usr/lib"
    ]
  ],
  "strip_stage_prefix": "",
  "test": [
    [
      "bash",
      "-euc",
      "ulimit -s -H unlimited; sed -e '/cpython/d' -i ../gcc/testsuite/gcc.dg/plugin/plugin.exp; set +e; make -k check; make_exit=$?; set -e; ../contrib/test_summary > gcc-test-summary.log; python3 /opt/alp-infra/scripts/infra/test-policy.py gcc --build . --make-exit \"$make_exit\" --output gcc-test-policy.json"
    ]
  ],
  "test_locale": "C",
  "test_policy": "gcc",
  "test_user": "tester",
  "validation": "Pinned MLFS ml-12.4 GCC 15.2 multilib recipe with only m64,m32, book m32 directory and stack-realignment adjustments, C/C++ tests run as tester, and exact pinned GCC expected-failure policy. DESTDIR install stages book-required cpp/man/LTO links and moves GDB helper scripts only within the stage. Guest build/test and Alp ownership acceptance remain pending.",
  "version": "15.2.0",
  "working_directories": {
    "compile": "build",
    "post_stage": "build",
    "stage": "build",
    "test": "build"
  }
}
