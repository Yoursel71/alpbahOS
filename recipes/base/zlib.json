{
  "abi": "multilib-m32",
  "adaptations": [
    "Build/test native multilib m64 first, then distclean and build the LFS ml_32 m32 library into /usr/lib32.",
    "Translate book DESTDIR to the ownership capture stage and remove only the documented m64 static library."
  ],
  "allowed_jobs": [
    1,
    2,
    4,
    8
  ],
  "basis": {
    "architecture": "ml_32",
    "book": "LFS-12.4-systemd",
    "commit": "d7bc803361f445a649d0ca0832219f75b6e68683",
    "file": "chapter08/zlib.xml",
    "repository": "https://git.linuxfromscratch.org/lfs.git",
    "sha256": "a2fd783b5e821e5cf2e35630b4d6e70e22021bfc6e6308d50695a9c4506e3b8b",
    "tag": "ml-12.4"
  },
  "compile": [
    [
      "./configure",
      "--prefix=/usr"
    ],
    [
      "make",
      "-j{jobs}"
    ]
  ],
  "environment": {},
  "jobs": 8,
  "name": "zlib",
  "phase": "base",
  "post_stage": [],
  "pre": [],
  "requires": [
    "man-pages",
    "iana-etc",
    "glibc"
  ],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
  "source": "zlib-1.3.1.tar.gz",
  "stage": [
    [
      "make",
      "-j1",
      "install",
      "DESTDIR={stage}"
    ],
    [
      "rm",
      "-f",
      "{stage}/usr/lib/libz.a"
    ],
    [
      "make",
      "distclean"
    ],
    [
      "env",
      "CFLAGS=-m32 -O2 -g0 -ffile-prefix-map={source}=/usr/src/zlib -fdebug-prefix-map={source}=/usr/src/zlib",
      "CXXFLAGS=-m32 -O2 -g0 -ffile-prefix-map={source}=/usr/src/zlib -fdebug-prefix-map={source}=/usr/src/zlib",
      "./configure",
      "--prefix=/usr",
      "--libdir=/usr/lib32"
    ],
    [
      "make",
      "-j{jobs}"
    ],
    [
      "make",
      "-j1",
      "install",
      "DESTDIR={stage}"
    ]
  ],
  "strip_stage_prefix": "",
  "test": [
    [
      "make",
      "-j{jobs}",
      "check"
    ]
  ],
  "validation": "Recipe only; m64/m32 build, test and Alp ownership remain unverified",
  "version": "1.3.1"
}
