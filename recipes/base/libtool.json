{
  "abi": "multilib-m32",
  "allowed_jobs": [
    1,
    2,
    4,
    8
  ],
  "basis": {
    "architecture": "ml_32",
    "book": "MLFS ml-12.4 m32-systemd",
    "commit": "d7bc803361f445a649d0ca0832219f75b6e68683",
    "file": "chapter08/libtool.xml",
    "repository": "https://git.linuxfromscratch.org/lfs.git",
    "sha256": "ecc927f6a58776dac826084985251e432bd555daf052d3299e3b6fae26777f48",
    "tag": "ml-12.4"
  },
  "compile": [
    [
      "./configure",
      "--prefix=/usr"
    ],
    [
      "make",
      "-j{jobs}"
    ]
  ],
  "environment": {},
  "jobs": 8,
  "name": "libtool",
  "phase": "base",
  "post_stage": [],
  "pre": [],
  "requires": [
    "glibc"
  ],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
  "source": "libtool-2.5.4.tar.xz",
  "stage": [
    [
      "make",
      "-j1",
      "DESTDIR={stage}",
      "install"
    ],
    [
      "rm",
      "-f",
      "{stage}/usr/lib/libltdl.a"
    ],
    [
      "make",
      "distclean"
    ],
    [
      "env",
      "CC=gcc -m32",
      "./configure",
      "--host=i686-pc-linux-gnu",
      "--prefix=/usr",
      "--libdir=/usr/lib32"
    ],
    [
      "make",
      "-j{jobs}"
    ],
    [
      "make",
      "-j1",
      "DESTDIR={stage}/.m32root",
      "install"
    ],
    [
      "cp",
      "-a",
      "{stage}/.m32root/usr/lib32/.",
      "{stage}/usr/lib32"
    ],
    [
      "rm",
      "-rf",
      "{stage}/.m32root"
    ]
  ],
  "strip_stage_prefix": "",
  "test": [
    [
      "make",
      "-j{jobs}",
      "check"
    ]
  ],
  "validation": "m64 test/install and MLFS m32 libltdl staged separately under /usr/lib32; no guest build or Alp ownership acceptance yet",
  "version": "2.5.4"
}
