  "strip_stage_prefix": "",
  "test": [
    [
      "bash",
      "-euc",
      "make NON_ROOT_USERNAME=tester check-root\ngroupadd -g 102 dummy -U tester\ncleanup_group() {{\n  status=$?\n  trap - EXIT\n  groupdel dummy || status=1\n  exit \"$status\"\n}}\ntrap cleanup_group EXIT\ntest_path=$PATH\nchown -hR tester:tester .\nrunuser -u tester -- env \"PATH=$test_path\" LC_ALL=C.UTF-8 LANG=C.UTF-8 TZ=UTC make -k RUN_EXPENSIVE_TESTS=yes check </dev/null"
    ]
  ],
  "test_locale": "C.UTF-8",
  "test_user": "root",
  "validation": "Pinned MLFS ml-12.4 Coreutils 9.7 patches/configure and DESTDIR/FHS staging. The book root checks and tester suite run only inside the Builder VM root coordinator; a temporary supplementary group is removed by an exit trap, and the source tree returns to lfs ownership. No guest build or Alp ownership acceptance yet.",
