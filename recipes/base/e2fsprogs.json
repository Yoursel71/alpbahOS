{
  "abi": "multilib-m32",
  "allowed_jobs": [
    1,
    2,
    4,
    8
  ],
  "basis": {
    "architecture": "ml_32",
    "book": "MLFS ml-12.4 m32-systemd",
    "commit": "d7bc803361f445a649d0ca0832219f75b6e68683",
    "file": "chapter08/e2fsprogs.xml",
    "repository": "https://git.linuxfromscratch.org/lfs.git",
    "sha256": "d6679ee5a924a097041ee388b7de7b855798312189d35795efdc49addaae3800",
    "tag": "ml-12.4"
  },
  "compile": [
    [
      "../configure",
      "--prefix=/usr",
      "--sysconfdir=/etc",
      "--enable-elf-shlibs",
      "--disable-libblkid",
      "--disable-libuuid",
      "--disable-uuidd",
      "--disable-fsck"
    ],
    [
      "make",
      "-j{jobs}"
    ]
  ],
  "environment": {},
  "jobs": 4,
  "name": "e2fsprogs",
  "phase": "base",
  "post_stage": [
    [
      "rm",
      "-f",
      "{stage}/usr/lib/libcom_err.a",
      "{stage}/usr/lib/libe2p.a",
      "{stage}/usr/lib/libext2fs.a",
      "{stage}/usr/lib/libss.a"
    ],
    [
      "gzip",
      "-d",
      "{stage}/usr/share/info/libext2fs.info.gz"
    ],
    [
      "install-info",
      "--dir-file={stage}/usr/share/info/dir",
      "{stage}/usr/share/info/libext2fs.info"
    ],
    [
      "makeinfo",
      "-o",
      "{stage}/usr/share/info/com_err.info",
      "../lib/et/com_err.texinfo"
    ],
    [
      "install-info",
      "--dir-file={stage}/usr/share/info/dir",
      "{stage}/usr/share/info/com_err.info"
    ],
    [
      "sed",
      "-i",
      "s/metadata_csum_seed,//",
      "{stage}/etc/mke2fs.conf"
    ]
  ],
  "pre": [
    [
      "mkdir",
      "-p",
      "build"
    ]
  ],
  "requires": [
    "glibc",
    "zlib",
    "util-linux",
    "texinfo"
  ],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
  "source": "e2fsprogs-1.47.3.tar.gz",
  "stage": [
    [
      "make",
      "-j1",
      "DESTDIR={stage}",
      "install"
    ]
  ],
  "strip_stage_prefix": "",
  "test": [
    [
      "make",
      "-j{jobs}",
      "check"
    ]
  ],
  "validation": "Pinned MLFS m32-systemd e2fsprogs 1.47.3 configure, make check and isolated DESTDIR install with static-library removal and documentation/index/config post-processing. The book defines no separate m32 build. No guest build or Alp ownership acceptance yet.",
  "version": "1.47.3",
  "working_directories": {
    "compile": "build",
    "post_stage": "build",
    "stage": "build",
    "test": "build"
  }
}
