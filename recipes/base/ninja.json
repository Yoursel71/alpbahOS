      "/int Guess/a \\\n  int   j = 0;\\\n  char* jobs = getenv( \"NINJAJOBS\" );\\\n  if ( jobs != NULL ) j = atoi( jobs );\\\n  if ( j > 0 ) return j;\\\n",
      "src/ninja.cc"
    ]
  ],
  "requires": [
    "python"
  ],
  "requires_oc_and_abi_authorization": true,
  "requires_stability_receipt": true,
  "schema": "alpbahOS.recipe/v1",
