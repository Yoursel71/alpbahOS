      "{stage}/usr/bin/ninja"
    ],
    [
      "install",
      "-vDm644",
      "misc/bash-completion",
      "{stage}/usr/share/bash-completion/completions/ninja"
    ],
    [
      "install",
      "-vDm644",
      "misc/zsh-completion",
      "{stage}/usr/share/zsh/site-functions/_ninja"
    ]
  ],
