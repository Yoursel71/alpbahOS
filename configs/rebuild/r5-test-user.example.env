# REBUILD-R5 example config (test only). Read by scripts/rebuild/image/r5-image-finish.sh.
# The account exists only in the disposable R5 Plasma test image, booted in local QEMU.
# It is not a real account.
# Leave R5_TEST_PASSWORD empty: r5-image-finish.sh then generates a random password at run time and
# writes it (mode 600, never printed) to scratch-lfs-bench/test-secrets/r5-test-user.pw.
# Note: an earlier version of this file held a fixed test password. That value stays in git history.
# It was a test-only password for a disposable local VM and protects nothing else.
R5_TEST_USER=r5test
R5_TEST_PASSWORD=
