# alpbahOS 0.9 Beta branding for Calamares 3.3.
---
componentName: alpbahos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

strings:
    productName:         alpbahOS
    shortProductName:    alpbahOS
    version:             0.9 Beta
    shortVersion:        0.9 Beta
    versionedName:       alpbahOS 0.9 Beta
    shortVersionedName:  alpbahOS 0.9 Beta
    bootloaderEntryName: alpbahOS     # GRUB_DISTRIBUTOR (grubcfg keep_distributor: false); name per D110
    productUrl:          https://example.invalid/alpbahos
    supportUrl:          https://example.invalid/alpbahos/support
    knownIssuesUrl:      https://example.invalid/alpbahos/issues
    releaseNotesUrl:     https://example.invalid/alpbahos/release-notes

images:
    # logo.png: branding/alpbahos-brand/logo/alpbahOS-logo-dark.svg (light wordmark, D155; the old navy wordmark was
    # unreadable on the dark installer, real-PC test 2026-11-11); icon.png: alpbahOS-mark.svg
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "logo.png"

# INSTALLER-02: numbered steps (calamares-sidebar.qml); the navigation buttons stay widgets (styled in stylesheet.qss),
# so their size and place do not change for the QEMU install lanes.
sidebar:                 qml
navigation:              widget
slideshow:               "show.qml"
slideshowAPI:            2

style:
   # alpbahOS colours (profiles/desktop/tokens.json). Calamares 3.3 reads the capitalised Sidebar* names (default/branding.desc);
   # the 3.2 lower-case names are kept for older readers. Round 28 still showed the current step dark on black.
   SidebarBackground:        "#0b1014"
   SidebarText:              "#d4e0e8"
   SidebarTextCurrent:       "#f4f8fb"
   SidebarBackgroundCurrent: "#062746"
   sidebarTextSelect:        "#f4f8fb"
   sidebarTextHighlight:     "#00aeef"
