# alpbahOS 0.9 Beta branding for Calamares 3.3.
---
componentName: alpbahos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

strings:
    productName:         alpbahOS
    shortProductName:    alpbahOS
    version:             0.9 Beta
    shortVersion:        BETA
    versionedName:       alpbahOS 0.9 Beta
    shortVersionedName:  alpbahOS BETA
    bootloaderEntryName: alpbahOS     # GRUB_DISTRIBUTOR (grubcfg keep_distributor: false); name per D110
    productUrl:          https://example.invalid/alpbahos
    supportUrl:          https://example.invalid/alpbahos/support
    knownIssuesUrl:      https://example.invalid/alpbahos/issues
    releaseNotesUrl:     https://example.invalid/alpbahos/release-notes

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "logo.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   # alpbahOS colours (profiles/desktop/tokens.json). Calamares 3.3 names (…Current) and the 3.2 names both set:
   # with the dark installer (INSTALLER-THEME-01) the 3.2 names alone left the current step dark on black.
   sidebarBackground:        "#0b1014"
   sidebarText:              "#d4e0e8"
   sidebarTextCurrent:       "#f4f8fb"
   sidebarBackgroundCurrent: "#062746"
   sidebarTextSelect:        "#f4f8fb"
   sidebarTextHighlight:     "#00aeef"
