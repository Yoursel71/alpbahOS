# alpbahOS (KUTU-LOCALE-01, round 42): the UTF-8 locales compiled into the image, in the canonical spelling. Calamares
# reads this (locale.conf localeGenPath) instead of 'locale -a', which spells them tr_TR.utf8: an installed
# /etc/locale.conf with LANG=tr_TR.utf8 broke distrobox-init (Debian's locale.gen has tr_TR.UTF-8; rc02 KUTU row).
cs_CZ.UTF-8 UTF-8
de_DE.UTF-8 UTF-8
en_GB.UTF-8 UTF-8
en_US.UTF-8 UTF-8
fa_IR.UTF-8 UTF-8
fr_FR.UTF-8 UTF-8
is_IS.UTF-8 UTF-8
it_IT.UTF-8 UTF-8
ja_JP.UTF-8 UTF-8
ru_RU.UTF-8 UTF-8
se_NO.UTF-8 UTF-8
ta_IN.UTF-8 UTF-8
tr_TR.UTF-8 UTF-8
zh_TW.UTF-8 UTF-8
