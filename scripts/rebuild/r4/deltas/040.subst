-D SHARED_ONLY=yes	-D LIBICAL_STATIC=NO
-D ICAL_BUILD_DOCS=false	-D LIBICAL_BUILD_DOCS=false
-D GOBJECT_INTROSPECTION=False	-D LIBICAL_GOBJECT_INTROSPECTION=false
-D ICAL_GLIB_VAPI=false -D ICAL_GLIB=false	-D LIBICAL_GLIB_VAPI=false -D LIBICAL_GLIB=true
-D LIBICAL_STATIC=NO	-D LIBICAL_STATIC=NO -D LIBICAL_JAVA_BINDINGS=OFF
cp -vr apidocs/html/* /usr/share/doc/libical-4.0.5/html	true # docs are not built (LIBICAL_BUILD_DOCS=false)
