+def _collect_process_trace_tree(trace_dir: Path, trace_prefix: Path, status_path: Path,
+                                aggregate_path: Path, status: int) -> dict[str, Any]:
+    """Keep raw strace files, but aggregate only the Bubblewrap child tree.
+
+    Bubblewrap's outer namespace setup is traced too, but is outside the
+    installer process tree. Its raw files remain preserved and are explicitly
+    listed as unselected; none are silently mixed into installer write checks.
+    """
