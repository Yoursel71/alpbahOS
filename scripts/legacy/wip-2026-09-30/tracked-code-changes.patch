+        aggregate.extend(line if line.endswith("\n") else line + "\n" for line in lines[start_at:])
+        # Only the root PID's pre-exec Bubblewrap setup is excluded; every
+        # process creation after the installer exec boundary remains followed.
+        pending.extend(_process_child_pids(path, lines[start_at:]))
+
+    aggregate_path.write_text("".join(aggregate), encoding="utf-8")
+    all_pids = sorted(files)
+    return {
+        "schema": "alpbahOS.m04-process-trace-tree/v1",
+        "root_host_pid": root_pid,
+        "exit_status": child_exit,
+        "command_start_line_by_host_pid": command_start_lines,
+        "installer_tree_host_pids": selected,
+        "unselected_host_pids": [pid for pid in all_pids if pid not in seen],
+        "files": [
