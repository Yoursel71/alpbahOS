+def _process_child_pids(trace_path: Path, trace_lines: Sequence[str] | None = None) -> list[int]:
+    """Read host PID/TID children from one strace -ff PID-namespace trace.
+
+    With --decode-pids=pidns, successful parent-side process-creation calls
+    include the tracee's host PID in a comment. A positive result without that
+    comment cannot be mapped to a trace filename and invalidates the capture.
+    """
+    children: list[int] = []
+    pending: set[str] = set()
+    lines = trace_lines if trace_lines is not None else trace_path.read_text(
+        encoding="utf-8", errors="replace").splitlines()
+    for line_no, line in enumerate(lines, 1):
+        match = SYSCALL_RE.match(line)
+        resumed = re.match(r"^\s*<\.\.\.\s+(clone3?|fork|vfork)\s+resumed>", line)
+        syscall = match.group(1) if match else (resumed.group(1) if resumed else None)
+        if syscall not in PROCESS_CREATION_SYSCALLS:
+            continue
+        if "<unfinished ...>" in line:
+            pending.add(syscall)
+            continue
+        if resumed:
+            if syscall not in pending:
+                raise CaptureError(f"unmatched resumed {syscall} in {trace_path}:{line_no}")
+            pending.remove(syscall)
+        result = re.search(r"\)\s+=\s+(-?\d+)(.*)$", line)
+        if not result:
+            raise CaptureError(f"cannot parse {syscall} result in {trace_path}:{line_no}: {line.strip()}")
+        returned = int(result.group(1))
+        if returned <= 0:
+            continue
+        mapped = PIDNS_HOST_PID_RE.search(result.group(2))
+        if not mapped:
+            raise CaptureError(
+                f"successful {syscall} lacks a PID-namespace host PID in {trace_path}:{line_no}"
+            )
+        children.append(int(mapped.group(1)))
+    if pending:
+        raise CaptureError(f"unfinished process-creation syscall in {trace_path}: {sorted(pending)}")
+    return children
+
