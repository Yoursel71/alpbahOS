+        status_records = [json.loads(line) for line in status_path.read_text(encoding="utf-8").splitlines()
+                          if line.strip()]
+    except (OSError, json.JSONDecodeError) as exc:
+        raise CaptureError(f"cannot parse Bubblewrap JSON status: {exc}") from exc
+    if len(status_records) < 2 or not isinstance(status_records[0], dict) or not isinstance(status_records[-1], dict):
+        raise CaptureError("Bubblewrap status is incomplete; expected child and exit records")
+    root_pid = status_records[0].get("child-pid")
+    child_exit = status_records[-1].get("exit-code")
+    if type(root_pid) is not int or root_pid <= 0:
+        raise CaptureError("Bubblewrap status has no valid child-pid")
+    if type(child_exit) is not int or child_exit != status:
+        raise CaptureError("Bubblewrap status exit code does not match the traced command")
