+        if pid in seen:
+            continue
+        path = files.get(pid)
+        if path is None:
+            raise CaptureError(f"missing strace -ff trace file for installer descendant {pid}")
+        seen.add(pid)
+        selected.append(pid)
+        aggregate.append(f"# installer-process host-pid={pid}\n")
+        lines = path.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
+        start_at = 0
+        if pid == root_pid:
