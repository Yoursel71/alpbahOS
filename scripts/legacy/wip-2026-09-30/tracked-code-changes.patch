+PROCESS_CREATION_SYSCALLS = {"clone", "clone3", "fork", "vfork"}
+PIDNS_HOST_PID_RE = re.compile(r"/\*\s*(\d+)\s+in strace's PID NS\s*\*/")
+TRACE_FILE_RE = re.compile(r"^(\d+)$")
+EXEC_SYSCALLS = {"execve", "execveat"}
