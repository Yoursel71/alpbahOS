## these variables are automatically generated by make ##
# Do not edit here. If you wish to override these values
# add them to the last section
set rootme "/srv/lfs/build/base-gcc/build/gcc"
set srcdir "/srv/lfs/build/base-gcc/gcc"
set host_triplet x86_64-pc-linux-gnu
set build_triplet x86_64-pc-linux-gnu
set target_triplet x86_64-pc-linux-gnu
set target_alias x86_64-pc-linux-gnu
set libiconv ""
set CFLAGS ""
set CXXFLAGS ""
set HOSTCC "gcc"
set HOSTCXX "g++"
set HOSTCFLAGS "-O2 -g0 -ffile-prefix-map=/srv/lfs/build/base-gcc=/usr/src/gcc -fdebug-prefix-map=/srv/lfs/build/base-gcc=/usr/src/gcc    "
set HOSTCXXFLAGS "-O2 -g0 -ffile-prefix-map=/srv/lfs/build/base-gcc=/usr/src/gcc -fdebug-prefix-map=/srv/lfs/build/base-gcc=/usr/src/gcc    "
set TEST_ALWAYS_FLAGS "--sysroot=/srv/lfs"
set TEST_GCC_EXEC_PREFIX "/usr/lib/gcc/"
set TESTING_IN_BUILD_TREE 1
set HAVE_LIBSTDCXX_V3 1
set ENABLE_PLUGIN 1
set PLUGINCC "g++"
set PLUGINCFLAGS "-g0 -ffile-prefix-map=/srv/lfs/build/base-gcc=/usr/src/gcc -fdebug-prefix-map=/srv/lfs/build/base-gcc=/usr/src/gcc"
set GMPINC ""
set tmpdir /srv/lfs/build/base-gcc/build/gcc/testsuite
set srcdir "${srcdir}/testsuite"
## All variables above are generated by configure. Do Not Edit ##
