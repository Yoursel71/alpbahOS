# alpbahOS GRUB theme (GRUB-THEME-01, D1). Generated by branding/grub-theme/tools/build_grub_theme.py.
title-text: ""
desktop-color: "#0b1014"
terminal-font: "JetBrains Mono Regular 16"
terminal-box: "terminal_box_*.png"
terminal-left: "7%"
terminal-top: "10%"
terminal-width: "86%"
terminal-height: "72%"
terminal-border: "0"

+ image {
  left = 7%
  top = 50%-129
  width = 220
  height = 151
  file = "mark.png"
}
+ label {
  left = 7%
  top = 50%+40
  width = 172
  height = 63
  text = "alpbah"
  font = "Inter Bold 52"
  color = "#f4f8fb"
}
+ label {
  left = 7%+172
  top = 50%+40
  width = 78
  height = 63
  text = "OS"
  font = "Inter Bold 52"
  color = "#00aeef"
}
+ label {
  left = 7%
  top = 50%+109
  width = 28%
  height = 20
  text = "@VERSION_LINE@"
  font = "JetBrains Mono Regular 15"
  color = "#8ea2af"
}
+ boot_menu {
  left = 39%
  top = 50%-127
  width = 54%
  height = 196
  item_font = "Inter Regular 20"
  selected_item_font = "Inter SemiBold Regular 20"
  item_color = "#d4e0e8"
  selected_item_color = "#f4f8fb"
  item_height = 40
  item_padding = 0
  item_spacing = 28
  icon_width = 0
  icon_height = 0
  item_icon_space = 14
  item_pixmap_style = "item_*.png"
  selected_item_pixmap_style = "select_*.png"
  scrollbar = true
  scrollbar_width = 4
  scrollbar_frame = "line.png"
  scrollbar_thumb = "line.png"
}
+ label {
  left = 39%
  top = 50%+93
  width = 95
  height = 18
  text = "Seçili sistem "
  font = "Inter Regular 15"
  color = "#8ea2af"
  id = "__timeout__"
}
+ label {
  left = 39%+95
  top = 50%+93
  width = 10
  height = 18
  text = "%d"
  font = "Inter Regular 15"
  color = "#ffc45d"
  id = "__timeout__"
}
+ label {
  left = 39%+104
  top = 50%+93
  width = 189
  height = 18
  text = " saniye içinde başlatılacak"
  font = "Inter Regular 15"
  color = "#8ea2af"
  id = "__timeout__"
}
+ progress_bar {
  id = "__timeout__"
  left = 39%
  top = 50%+111
  width = 54%
  height = 28
  bar_style = "progress_bar_*.png"
  highlight_style = "progress_highlight_*.png"
  show_text = false
}
